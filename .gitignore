# =============================================================================
# ComplianceCheck — .gitignore
# Prevents accidental publication of sensitive, generated, and binary files.
# =============================================================================

# ── Private / Excluded ────────────────────────────────────────────────────────
private/
private/**

# ── Credentials & Secrets ────────────────────────────────────────────────────
.env
.env.*
*.key
*.pem
*.p12
*.pfx
secrets.json
credentials.json

# ── Runtime-Generated Data ────────────────────────────────────────────────────
# These files are created at runtime and may contain personal paths,
# previously scanned document names, or organization-specific information.
data/scan_history.json
data/activity_log.json
data/discovery_stats.json
data/last_scan_diagnostics.json
data/last_scan_performance.json
data/learning_stats.json
data/settings.json
data/runtime_manifest.json
data/kb_state.json

# ── Generated Reports ─────────────────────────────────────────────────────────
# Reports generated by the application may contain references to
# documents that were scanned during development.
reports/
exports/

# ── Organization Logos ────────────────────────────────────────────────────────
# Logos may belong to real companies; contributors should add their own.
organization_logos/
rules/organization_logos/

# ── Application Logs ─────────────────────────────────────────────────────────
logs/
*.log
debug.log

# ── Python Artifacts ─────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
.Python
*.egg
*.egg-info/
dist-info/
.eggs/

# ── PyInstaller Build Artifacts ───────────────────────────────────────────────
build/
dist/
*.spec.bak
*.pkg
*.pyz
*.toc
*.manifest
warn-*.txt
xref-*.html
*.exe
*.pkg
base_library.zip
localpycs/
Analysis-*.toc
EXE-*.toc
PKG-*.toc
PYZ-*.toc
PYZ-*.pyz

# ── Compiled Release Packages ────────────────────────────────────────────────
*.zip
CA2_Test/
ComplianceCheck_v1.0.0/
ComplianceCheck_v1.0.0.zip

# ── Scratch / Dev Utilities ───────────────────────────────────────────────────
scratch/
apply_get_color.py
apply_typography.py
patch_rules.py
theme_apply.py

# ── Test Dumps / Temporary Directories ───────────────────────────────────────
Test-Dump/

# ── Virtual Environments ─────────────────────────────────────────────────────
venv/
.venv/
env/
.env/
ENV/
*.virtualenv

# ── IDE & Editor ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.spyderproject
.spyproject

# ── OS Metadata ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ── Temporary Files ───────────────────────────────────────────────────────────
*.tmp
*.bak
*.swp
*.swo
~$*

# ── Jupyter Notebooks (if any) ───────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Testing Artifacts ────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
